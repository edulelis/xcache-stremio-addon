# Public URL where your self-hosted addon is reachable.
PUBLIC_BASE_URL=https://xcache.example.com
BASE_PATH=

# Private secret used to derive the public install token.
# Generate with: openssl rand -hex 32
INSTALL_TOKEN_SECRET=replace-with-random-secret

# qBittorrent is intended to be reachable only inside Docker.
QBITTORRENT_URL=http://qbittorrent:8080
QBITTORRENT_USER=xcache
QBITTORRENT_PASS=replace-with-qbittorrent-password

# Optional. Leave empty to disable RD acceleration.
REAL_DEBRID_API_TOKEN=
RD_MODE=rd_plus_local
XCACHE_RD_AVAILABILITY_CACHE_TTL_MS=300000
XCACHE_RD_AVAILABILITY_BLOCKING=false

# Optional. Used to resolve tmdb: IDs to tt IDs before querying source addons.
# This improves native Stremio clients when metadata providers keep tmdb: IDs.
TMDB_API_KEY=
TMDB_READ_ACCESS_TOKEN=
XCACHE_TMDB_RESOLVER_TIMEOUT_MS=3000
XCACHE_TMDB_ID_CACHE_TTL_MS=86400000

# Cache paths are container paths. docker-compose mounts these to host volumes.
CACHE_DIR=/cache
CACHE_DB_PATH=/cache/xcache.sqlite
CACHE_MAX_BYTES=100GiB
CACHE_MIN_FREE_BYTES=50GiB
XCACHE_LOCAL_READY_MIN_PROGRESS=0.98
XCACHE_PLAYABLE_WAIT_MS=5000
XCACHE_STATUS_VIDEO_MODE=live_hls
XCACHE_STATUS_SEGMENT_SECONDS=8
XCACHE_STATUS_PLAYLIST_WINDOW=6
XCACHE_STATUS_SEGMENT_CACHE_TTL_MS=60000
XCACHE_STATUS_SEGMENT_CACHE_DIR=/tmp/xcache-status
XCACHE_FFMPEG_PATH=ffmpeg
XCACHE_FFPROBE_PATH=ffprobe
XCACHE_MKVPROPEDIT_PATH=mkvpropedit
XCACHE_STATUS_FONT_FILE=
XCACHE_AUDIO_DEFAULT_ENABLED=false
XCACHE_AUDIO_LANGUAGE_PRIORITY=

# Source stream endpoints. Use Stremio-compatible /stream/{type}/{id}.json URL templates.
# Example value:
# SCRAPER_STREAM_URLS=https://your-source.example/{type}/{id}.json
SCRAPER_STREAM_URLS=
XCACHE_STREAM_CACHE_TTL_MS=600000
XCACHE_PLAY_INTENT_TTL_MS=86400000
XCACHE_SCRAPER_TIMEOUT_MS=10000
XCACHE_LOCAL_STREAM_SEARCH_WAIT_MS=2500

XCACHE_ALLOWED_RESOLUTIONS=1080p,720p
XCACHE_PREFERRED_LANGUAGES=pt-BR,pt,en
XCACHE_PREFERRED_PROVIDERS=Comando,MicoLeaoDublado,BluDV
XCACHE_BLOCKED_PROVIDERS=Cinecalidad
XCACHE_ALLOW_SPANISH_NATIVE=false
XCACHE_STREAM_LIMIT=8

PORT=7331
