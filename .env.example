# Public URL where your self-hosted addon is reachable.
PUBLIC_BASE_URL=https://xcache.example.com
BASE_PATH=

# Private secret used to derive the public install token.
# Generate with: openssl rand -hex 32
INSTALL_TOKEN_SECRET=replace-with-random-secret

# qBittorrent is intended to be reachable only inside Docker.
QBITTORRENT_URL=http://qbittorrent:8080
QBITTORRENT_USER=xcache
QBITTORRENT_PASS=replace-with-qbittorrent-password

# Optional. Leave empty to disable RD acceleration.
REAL_DEBRID_API_TOKEN=
RD_MODE=rd_plus_local

# Cache paths are container paths. docker-compose mounts these to host volumes.
CACHE_DIR=/cache
CACHE_DB_PATH=/cache/xcache.sqlite
CACHE_MAX_BYTES=100GiB
CACHE_MIN_FREE_BYTES=50GiB

# Source stream endpoints. Use Stremio-compatible /stream/{type}/{id}.json URL templates.
# Example value:
# SCRAPER_STREAM_URLS=https://your-source.example/{type}/{id}.json
SCRAPER_STREAM_URLS=

XCACHE_ALLOWED_RESOLUTIONS=1080p,720p
XCACHE_PREFERRED_LANGUAGES=pt-BR,pt,en
XCACHE_PREFERRED_PROVIDERS=Comando,MicoLeaoDublado,BluDV
XCACHE_BLOCKED_PROVIDERS=Cinecalidad
XCACHE_ALLOW_SPANISH_NATIVE=false
XCACHE_STREAM_LIMIT=8

PORT=7331
